{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "website/dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.DS_Store",
      "**/.git/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/r",
        "destination": "/open.html"
      },
      {
        "source": "/l/**",
        "destination": "/open.html"
      },
      {
        "source": "/features",
        "destination": "/index.html"
      },
      {
        "source": "/ar",
        "destination": "/index.html"
      },
      {
        "source": "/ar/features",
        "destination": "/index.html"
      }
    ]
  }
}
